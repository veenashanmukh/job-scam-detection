# Copy to .env and fill in. Never commit .env.
# LLM provider is chosen at runtime (provider-agnostic wrapper is built in Phase 4).
LLM_PROVIDER=gemini        # gemini | groq
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=                 # set after checking your account's model list and limits
LLM_REQUESTS_PER_MINUTE=   # set from your account's actual limit page
